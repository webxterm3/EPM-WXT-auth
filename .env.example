# Server Configuration
PORT=8082
ENVIRONMENT=development
GIN_MODE=release
# Keycloak Configuration
KEYCLOAK_URL=http://172.16.109.151:30007
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Super Admin Configuration
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# MongoDB Configuration
MONGO_URI=
MONGO_DATABASE=vsay-epm

# Backend Services
VSAY_AGENT_BACKEND_URL=http://localhost:8080
BACKEND_PROXY_PREFIX=/api
# Gateway secret token for internal service communication (keep this secret!)
GATEWAY_SECRET=
# VSAY_TUNNEL_URL=http://localhost:8083

# wxt-log-manager — reading endpoint system logs back out of the archive.
# Unset means /api/logs/endpoint answers 503 saying so, rather than 404.
# GATEWAY_SECRET above must match the one wxt-log-manager is given.
WXT_LOG_MANAGER_URL=http://localhost:8090

# JWT Configuration
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# Email Configuration (for OTP and notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# # OTP Configuration
OTP_ENABLED=false
OTP_EXPIRY_MINUTES=10

# Reconciler Configuration
# RECONCILER_ENABLED=false  → run once on startup only, no periodic sync
# RECONCILER_INTERVAL_MINUTES=0 → same effect (disabled)
RECONCILER_ENABLED=false
RECONCILER_INTERVAL_MINUTES=5

# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URL (used in email templates)
FRONTEND_URL=http://localhost:3000

# # OIDC / Social Login
# # Microsoft Azure AD App (ClientID + Secret Value)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# # Azure AD tenant ID — set to your specific tenant ID for single-org apps,
# # or leave as "common" and make the app multi-tenant in Azure Portal.
# MICROSOFT_TENANT_ID=common

# # GitHub OAuth App
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Public base URL of THIS Go backend (used as redirect_uri base in OAuth flows).
# IMPORTANT: This must be the URL where your Go backend (port 8082) is reachable,
# NOT the Keycloak URL. Update this to your actual backend NodePort/ingress URL.
# Register these exact callback URLs in Azure/GitHub portals:
#   Microsoft: {OIDC_REDIRECT_BASE_URL}/api/auth/oidc/microsoft/callback
#   GitHub:    {OIDC_REDIRECT_BASE_URL}/api/auth/oidc/github/callback
OIDC_REDIRECT_BASE_URL=http://localhost:8082


LICENSE_TOKEN=
LICENSE_PUBLIC_KEY=
LICENSE_ENCRYPT_KEY=
# LICENSE_DEV_MODE=only-to-run-wxt-in-dev-mode
