# Server Configuration
PORT=8081
ENVIRONMENT=development
GIN_MODE=release

# Keycloak Configuration
KEYCLOAK_URL=
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=vsay-auth
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Super Admin Configuration
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# MongoDB Configuration
MONGO_URI=
MONGO_DATABASE=epm_auth

# Backend Services
VSAY_AGENT_BACKEND_URL=http://localhost:8080
GATEWAY_SECRET=

# JWT
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@webxterm.me

# OTP
OTP_ENABLED=true
OTP_EXPIRY_MINUTES=10

# Reconciler
RECONCILER_INTERVAL_MINUTES=5
RECONCILER_ENABLED=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# OIDC / Social Login
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_REDIRECT_BASE_URL=http://localhost:8081

# ── EPM License Enforcement ─────────────────────────────────────────────────
# Issued by https://licence.webxterm.me — drop the .tok file on the server and
# set LICENSE_FILE_PATH to its absolute path.
#
# PRODUCTION: set LICENSE_FILE_PATH. Leave LICENSE_DEV_MODE unset.
# DEV ONLY:   leave LICENSE_FILE_PATH empty AND set LICENSE_DEV_MODE=only-to-run-wxt-in-dev-mode (exact string).
#             Any other value is rejected. Startup fails if LICENSE_FILE_PATH is empty and the magic string is not set.
#
# LICENSE_PUBLIC_KEY  → fetch once: curl https://licence.webxterm.me/api/v1/public-key
# LICENSE_ENCRYPT_KEY → same value as LICENSE_ENCRYPT_KEY on the portal (.env)
# LICENSE_TOKEN       → paste the raw token string from the portal email directly here
LICENSE_TOKEN=
LICENSE_PUBLIC_KEY=dgYzsKL5MTHIbi7BNLWn1ybggMIbmEqHz0H7h6sYGJk=
LICENSE_ENCRYPT_KEY=
LICENSE_DEV_MODE=only-to-run-wxt-in-dev-mode
